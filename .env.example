# =============================================================================
# Aruba Wireless AI Analyzer — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# --- Mock Mode (set to true for local development without a real controller) ---
MOCK_MODE=true

# --- Aruba Controller ---
ARUBA_CONTROLLER_HOST=192.168.1.1
ARUBA_CONTROLLER_PORT=4343
ARUBA_USERNAME=admin
ARUBA_PASSWORD=your_password_here
ARUBA_API_VERSION=v1
ARUBA_SSL_VERIFY=false

# --- Hermes AI Agent ---
HERMES_AGENT_URL=http://hermes:8080
HERMES_API_KEY=your_hermes_api_key_here

# --- LLM Provider ---
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- App Settings ---
POLL_INTERVAL_SECONDS=30
ALERT_RSSI_THRESHOLD=-75
ALERT_CHANNEL_UTIL_THRESHOLD=80
LOG_LEVEL=INFO
